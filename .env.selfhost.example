# Production settings for docker-compose.prod.yml. Copy to .env, replace every CHANGE-ME, and
# never commit the result. Walkthrough: docs/self-hosting.md. Every variable: ENV_VARS.md.

# Bundled Postgres. The password must match the one inside DATABASE_URL.
POSTGRES_USER=arcodash
POSTGRES_PASSWORD=CHANGE-ME
POSTGRES_DB=arcodash
DATABASE_URL=postgres://arcodash:CHANGE-ME@postgres:5432/arcodash
VALKEY_URL=redis://valkey:6379

APP_HOST=0.0.0.0
APP_PORT=8080
RUST_LOG=info

# Required; the backend refuses to start without them. Generate each with: openssl rand -hex 32
# (ENCRYPTION_KEY must be 64 hex characters).
COOKIE_SECRET=
ENCRYPTION_KEY=

# BASE_URL is the address users open (CORS origin, links in emails, embeds, SAML). API_BASE_URL is
# where the browser reaches the backend; it is built into the frontend image, so rebuild after
# changing it. The ports are what this host publishes; behind a reverse proxy on this host, use
# 127.0.0.1:80 and 127.0.0.1:8080 so they are reachable only through the proxy.
BASE_URL=http://localhost
API_BASE_URL=http://localhost:8080
FRONTEND_PORT=80
BACKEND_PORT=8080

# First admin, created on the first start (a no-op afterwards). Set both; while blank, no admin
# is created and there is no sign-up page.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Outgoing mail (invites, password resets, alerts). SMTP_TLS: starttls (587), wrapper (465) or none.
SMTP_HOST=CHANGE-ME
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_FROM=arcodash@your-domain.example
SMTP_USERNAME=CHANGE-ME
SMTP_PASSWORD=CHANGE-ME

# Bucket in the bundled object store (CSV/SQLite uploads); created on first start.
UPLOAD_BUCKET=arcodash-uploads

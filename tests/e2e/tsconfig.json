{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "types": ["node"],
    "typeRoots": ["../../apps/frontend/node_modules/@types", "../../node_modules/@types"]
  },
  "include": ["**/*.ts"],
  "exclude": ["test-results"]
}
